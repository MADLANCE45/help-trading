{
  "manifest_version": 3,
  "name": "Solana Pump Radar",
  "version": "1.0",
  "description": "Rileva rug pulls e sniper bot su Pump.fun e Axiom",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.ngrok-free.dev/*",
    "https://*.pump.fun/*",
    "https://*.axiom.trade/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pump Radar"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pump.fun/*", 
        "*://pump.fun/*",
        "*://*.axiom.trade/*",
        "*://axiom.trade/*"
      ],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pumpradar@solana.com",
      "strict_min_version": "109.0"
    }
  }
}
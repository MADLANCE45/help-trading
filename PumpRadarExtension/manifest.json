{
  "manifest_version": 3,
  "name": "Meme Saver - Solana & EVM Pump Radar",
  "version": "2.0",
  "description": "AI Rug Pull Detector & Smart Money Tracker for Pump.fun and DexScreener",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://help-trading-production.up.railway.app/*",
    "https://*.pump.fun/*",
    "https://*.axiom.trade/*",
    "https://*.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pump Radar"
  },
  "content_scripts": [
    
    {
      "matches": [
        "*://*.pump.fun/*", 
        "*://pump.fun/*",
        "*://*.axiom.trade/*",
        "*://axiom.trade/*",
        "*://*.dexscreener.com/*",
        "*://dexscreener.com/*",
        "*://*.dexscreener.com/robinhood/*"
        
      ],
      "js": ["content.js"]
      
    }
    
  ],
  "web_accessible_resources": [
    {
      "resources": ["avatar1.png", "avatar2.png", "avatar3.png", "avatar4.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{5c8a3c22-7945-48b5-901d-8b01239c0f99}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
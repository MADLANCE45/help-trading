{
  "manifest_version": 3,
  "name": "Solana Pump Radar",
  "version": "1.0",
  "description": "Detect rug pulls and sniper bots on Pump.fun and Axiom",
"icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://help-trading-production.up.railway.app/*",
    "https://*.pump.fun/*",
    "https://*.axiom.trade/*",
    "https://*.dexscreener.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pump Radar"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pump.fun/*", 
        "*://pump.fun/*",
        "*://*.axiom.trade/*",
        "*://axiom.trade/*",
        "*://*.dexscreener.com/*",
        "*://dexscreener.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pumpradar@solana.com",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["avatar1.png", "avatar2.png", "avatar3.png", "avatar4.png"],
      "matches": ["<all_urls>"]
    }
  ]
}